{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "functions": {
    "api/*.py": {
      "maxDuration": 300,
      "excludeFiles": "{bundles,assets,tests}/**"
    }
  },
  "headers": [
    {"source": "/(.*)", "headers": [
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "Referrer-Policy", "value": "no-referrer"},
      {"key": "X-Frame-Options", "value": "SAMEORIGIN"}
    ]},
    {"source": "/api/(.*)", "headers": [{"key": "Cache-Control", "value": "no-store"}]},
    {"source": "/bundles/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}]}
  ]
}
